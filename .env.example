# Flask Core Settings
FLASK_APP=run.py
FLASK_DEBUG=0

# Application Secrets (Must be generated securely in production: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Initial Super Admin (Required for database seeding; read strictly from environment)
ADMIN_EMAIL=admin@example.pk
ADMIN_PASSWORD=change_this_secure_admin_password_123!

# PostgreSQL Database Connection
# Local: postgresql://username:password@localhost:5432/database_name
# Render: Render Internal Database URL (sslmode=require enforced automatically in production)
DATABASE_URL=postgresql://user:password@localhost:5432/railsathi_db

# Test Database Connection (Required for running pytest suite on PostgreSQL)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/railsathi_test_db

# Security & Session Policies
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600

